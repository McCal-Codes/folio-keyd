<!-- Editing for Keyd 0.3.0: swipe up to edit, slide from shift to select, the toolbar you arrange, and selection tools. -->
<resources>
    <!-- The toolbar while text is selected -->
    <plurals name="selection_characters">
        <item quantity="one">%1$s character</item>
        <item quantity="other">%1$s characters</item>
    </plurals>
    <plurals name="selection_words">
        <item quantity="one">%1$s word</item>
        <item quantity="other">%1$s words</item>
    </plurals>
    <string name="selection_count">%1$s · %2$s</string>
    <string name="selection_many">%1$s+ characters</string>
    <string name="selection_style">Style</string>
    <string name="style_note">Styled letters are symbols, not text: screen readers may read them oddly, and search won’t find them.</string>

    <!-- Keys and gestures › Editing -->
    <string name="header_editing">EDITING</string>
    <string name="settings_edit_swipes">Swipe up on Z X C V A to edit</string>
    <string name="settings_edit_swipes_note">Undo, cut, copy, paste, select all</string>
    <string name="settings_shift_select">Slide from shift to select</string>
    <string name="settings_selection_tools">Word count and styles when text is selected</string>
    <string name="row_toolbar">Toolbar</string>
    <plurals name="value_buttons">
        <item quantity="one">%1$d button</item>
        <item quantity="other">%1$d buttons</item>
    </plurals>
    <string name="footer_editing">On those five keys a swipe up edits instead of typing a capital. Turn it off to get the capital back.</string>

    <!-- Keys and gestures › Toolbar -->
    <string name="header_on_toolbar">ON THE TOOLBAR</string>
    <string name="header_more_buttons">MORE BUTTONS</string>
    <string name="tool_hide">Hide</string>
    <string name="value_always_first">Always first</string>
    <string name="footer_on_toolbar">Up to 7 besides Hide, so every button stays big enough to hit on a narrow screen. Voice only shows when your phone has a voice keyboard.</string>
    <string name="footer_more_buttons">Undo and Redo work in most apps. A few ignore them, and then nothing happens.</string>
    <string name="footer_voice">The mic hands you to your phone’s own voice keyboard. That keyboard is not Keyd and does use the Internet. Keyd comes back when you’re done.</string>
