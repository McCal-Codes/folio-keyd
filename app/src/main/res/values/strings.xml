    <string name="setup_title">Keyd</string>
    <string name="setup_intro">Android asks you to allow a keyboard twice: once to add it, and again to choose it. Both steps are below.</string>
    <string name="setup_step_one">1. Add Keyd in Android\'s settings</string>
    <string name="setup_step_two">2. Choose it as your keyboard</string>
    <string name="setup_warning">Android warns that a keyboard can see what you type. That is true of every keyboard — the system sends it your keystrokes. Keyd asks for no permissions at all, including no Internet permission, so what it sees cannot leave this phone.</string>
    <string name="setup_state_not_added">Not added yet. Step 1 opens the list Android keeps of the keyboards it allows.</string>
    <string name="setup_state_added">Added. Use step 2 to switch to it — some phones put their own keyboard back afterwards, so check it comes up in the field below.</string>
    <string name="setup_state_in_use">Added, and in use. Tap the field below to see it.</string>
    <string name="setup_try_it">Try it here</string>
    <string name="setup_try_hint">Type something</string>
    <string name="emoji_letters">ABC</string>
    <string name="emoji_no_recents">Emoji you use will show up here</string>
    <string name="emoji_search">Search emoji</string>
    <string name="emoji_search_field">Search emoji, %1$s</string>
    <string name="emoji_search_back">Back to emoji</string>
    <string name="emoji_search_clear">Clear search</string>
    <string name="emoji_search_hint">Type a word, like heart or cat</string>
    <string name="emoji_search_none">Nothing for “%1$s”</string>
    <string name="setup_learning">Keyd remembers words you type that it does not already know — names, places, the way you spell things — so it stops suggesting something else instead. It is kept on this phone, never from a password field, and never from an app that asks it not to.</string>
    <plurals name="setup_forget">
        <item quantity="one">Forget the word it has learned, and the fixes it has counted</item>
        <item quantity="other">Forget the %1$d words it has learned, and the fixes it has counted</item>
    </plurals>
    <string name="setup_forget_counts">Forget the fixes it has counted</string>
    <string name="setup_forget_none">It has not learned any words yet</string>
    <string name="setup_forgot">Forgotten.</string>
    <string name="settings_title">Keyd settings</string>
    <string name="settings_open">Settings</string>
    <string name="settings_suggestions">Suggestions</string>
    <string name="settings_autocorrect">Fix clear typos</string>
    <string name="settings_learn">Learn new words</string>
    <string name="settings_suggest_emoji">Suggest an emoji</string>
    <string name="settings_suggest_emoji_sub">When a word has one</string>
    <string name="settings_password_manager">Password manager suggestions</string>
    <string name="settings_password_manager_sub">Logins and codes in the strip</string>
    <string name="settings_password_manager_note">Your password manager draws those itself; Keyd places them and never sees what they say.</string>
    <string name="settings_suggest_emoji_note">Emoji come from Unicode\'s own emoji names, in the language you are typing, so pizza offers 🍕. Nothing is looked up online.</string>
    <string name="suggested_emoji">Emoji %1$s</string>
    <string name="settings_learn_note">Remembers words it does not know, so it stops suggesting something else instead. Never from a password field, or from an app that asks it not to.</string>
    <string name="settings_capitals">Capital at the start of a sentence</string>
    <string name="settings_capitals_note">Only where the app asks for it.</string>
    <string name="settings_double_space">Double-space for a period</string>
    <string name="settings_double_space_note">Two spaces after a word become a period and a space.</string>
    <string name="settings_number_row">Number row</string>
    <string name="settings_number_row_note">Digits on their own row instead of behind the 123 key. Costs a row of height.</string>
    <string name="settings_back_to_letters">Back to letters after a space</string>
    <string name="settings_back_to_letters_note">After numbers or symbols</string>
    <string name="settings_accents">Hold a key for accents</string>
    <string name="settings_accents_note">é, ñ, ü and the rest. The digits in the corners of the top row still work either way.</string>
    <string name="settings_preview">Show the letter above your finger</string>
    <string name="settings_sound">Sound</string>
    <string name="settings_system_note">Sound and vibration also follow the phone’s own settings.</string>
    <string name="settings_flick_down">Flick down for the corner character</string>
    <string name="settings_flick_down_note">The digit printed on the top row, without waiting for a long press. It is already on the keycap, so nothing is hidden.</string>
    <string name="settings_flick_up">Flick a letter up for a capital</string>
    <string name="settings_flick_up_note">Faster than shift for a single letter.</string>
    <string name="settings_gestures_note">Every gesture needs a deliberate journey, so the drift of typing fast is never mistaken for one.</string>
    <string name="settings_size">Keyboard height</string>
    <string name="settings_size_note">How much of the screen the keys take. Taller is easier to hit; shorter leaves more of what you are typing into.</string>
    <string name="settings_size_small">Short</string>
    <string name="settings_size_medium">Normal</string>
    <string name="settings_size_large">Tall</string>
    <string name="settings_appearance">Light or dark</string>
    <string name="settings_appearance_note">Following the phone is what almost everyone wants.</string>
    <string name="settings_appearance_system">Phone</string>
    <string name="settings_appearance_light">Light</string>
    <string name="settings_appearance_dark">Dark</string>
    <string name="settings_split">Split keyboard</string>
    <string name="settings_split_note">Two halves under two thumbs. Automatic splits on a screen big enough in both directions — unfolded, or a tablet — and not on a phone lying on its side.</string>
    <string name="settings_split_auto">Auto</string>
    <string name="settings_split_always">Always</string>
    <string name="settings_split_never">Never</string>
    <string name="settings_one_handed">One-handed</string>
    <string name="settings_one_handed_note">A narrower keyboard against one edge. Only on screens too small to split.</string>
    <string name="settings_one_handed_off">Off</string>
    <string name="settings_one_handed_left">Left</string>
    <string name="settings_one_handed_right">Right</string>
    <string name="one_handed_full_width">Full width</string>
    <string name="one_handed_other_side">Move to the other side</string>
    <string name="settings_cursor_swipe">Swipe the space bar to move the cursor</string>
    <string name="settings_delete_word">Swipe left on backspace for a word</string>
    <string name="settings_swipe_hide">Swipe down on the space bar to hide</string>
    <string name="settings_reset">Put every setting back to normal</string>
    <string name="shortcuts_title">Text shortcuts</string>
    <string name="shortcuts_note">A short word that stands for a longer one: type it, and the phrase is offered first in the strip. It is only ever offered — nothing is replaced until you tap it.</string>
    <string name="shortcuts_trigger_hint">Short word, e.g. omw</string>
    <string name="shortcuts_phrase_hint">What it stands for, e.g. on my way</string>
    <string name="shortcuts_add">Add</string>
    <string name="shortcuts_remove">Remove</string>
    <string name="shortcuts_row">%1$s  →  %2$s</string>
    <string name="shortcuts_empty">No shortcuts yet.</string>
    <string name="shortcuts_rejected">A shortcut needs a single word and something different for it to stand for.</string>
    <string name="settings_high_contrast">High contrast</string>
    <string name="settings_high_contrast_note">Pushes the keys and their labels as far apart as they go, rather than the softer greys of the ordinary palette.</string>
    <string name="settings_spell_check">Underline words it doesn’t know</string>
    <string name="settings_spell_check_sub">Never in a password field.</string>
    <string name="settings_spell_check_note">The same squiggle the rest of the phone uses for a misspelling. Tap an underlined word and the editor offers what it thinks you meant. Never in a password field.</string>
    <string name="settings_clipboard">Clipboard history</string>
    <string name="settings_clipboard_note">Keeps what you copy so you can put it back without leaving the keyboard. Nothing from a password field, nothing an app marks sensitive, and forgotten after an hour unless you pin it. It stays on this phone: Keyd has no way to send anything anywhere.</string>
    <string name="clipboard_empty">Nothing copied yet</string>
    <string name="clipboard_clear">Clear all</string>
    <string name="clipboard_clear_unpinned">Clear unpinned</string>
