<?xml version="1.0" encoding="utf-8"?>
<!--
  The password manager's chips, drawn by the manager itself with this shape behind them. White so the keyboard can
  tint it to the key color of whichever theme is on; the manager never needs to know which one that is.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="17dp" />
</shape>
